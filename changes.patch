diff --git a/tests/crypto-v3.test.mjs b/tests/crypto-v3.test.mjs
index 8bb5266..a3a6bfa 100644
--- a/tests/crypto-v3.test.mjs
+++ b/tests/crypto-v3.test.mjs
@@ -190,6 +190,16 @@ async function run() {
   const v2File = new Uint8Array([0x43, 0x49, 0x50, 0x48, 0x02, 0, 0, 0]);
   await expectCode(() => C.decryptFile(v2File, password), 'LEGACY_FORMAT');
 
+  // 前綴大小寫不敏感，本體仍區分大小寫。
+  const caseV3 = await C.encryptText('大小寫測試', password);
+  const bodyV3 = caseV3.slice('CIPHER3:'.length);
+  for (const prefix of ['cipher3:', 'Cipher3:']) {
+    assert.equal(C.looksLikeV3Text(' ' + prefix + bodyV3), true);
+    assert.equal(await C.decryptText(prefix + bodyV3, password), '大小寫測試');
+  }
+  assert.equal(C.looksLikeV3Text('cipher4:' + bodyV3), false);
+  assert.equal(C.looksLikeLegacyText('cipher2:abc'), true);
+
   console.log('CIPHER v3 tests passed');
 }
 
diff --git a/tests/crypto-v4.test.mjs b/tests/crypto-v4.test.mjs
index 087c361..bd00034 100644
--- a/tests/crypto-v4.test.mjs
+++ b/tests/crypto-v4.test.mjs
@@ -98,6 +98,20 @@ async function run() {
   assert.equal(V4.isLegacyFile(oldFile), true);
   assert.deepEqual(new Uint8Array((await V3.decryptFile(oldFile, oldPassword)).buffer), fileBytes);
 
+  // 前綴大小寫不敏感（手機備忘錄／鍵盤可能改動開頭），本體仍區分大小寫。
+  const caseText = await V4.encryptText('大小寫測試', phrase);
+  const body = caseText.slice('CIPHER4:'.length);
+  for (const prefix of ['cipher4:', 'Cipher4:', 'cIpHeR4:']) {
+    const variant = '  ' + prefix + body + '\n';
+    assert.equal(V4.looksLikeV4Text(variant), true);
+    assert.equal(await V4.decryptText(variant, phrase), '大小寫測試');
+  }
+  assert.equal(V4.looksLikeV4Text('ciphe4:' + body), false);
+  assert.equal(V4.looksLikeV4Text('CIPHER3:' + body), false);
+  await assert.rejects(() => V4.decryptText('cipher4:' + body.toLowerCase(), phrase), error => error && error.name === 'CipherV4Error');
+  assert.equal(V4.looksLikeLegacyText('cipher2:abc'), true);
+  assert.equal(V4.looksLikeLegacyText('Cipher3:abc'), true);
+
   console.log('CIPHER v4 recovery phrase tests passed');
 }
 
